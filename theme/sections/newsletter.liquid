<section class="band{% if section.settings.background != 'none' and section.settings.background != blank %} band--{{ section.settings.background }}{% endif %} newsletter" id="newsletter">
  {%- comment -%}
    One card the width of the page, like the sections above it: what the letter is on the
    left, the email field on the right. On a phone the two stack.
  {%- endcomment -%}
  <div class="wrap">
    <div class="newsletter__card">
    <div class="newsletter__intro">
      {%- if section.settings.kicker != blank -%}
        <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    {% form 'customer', class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- if form.posted_successfully? -%}
        <p class="notice" role="status">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="newsletter__row">
        <div class="field field--soft">
          <label for="newsletter-email">{{ 'contact.email' | t }}</label>
          <input id="newsletter-email" type="email" name="contact[email]" autocomplete="email" required>
        </div>
        <button type="submit" class="button">{{ 'newsletter.subscribe' | t }}</button>
      </div>
    {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "Same as the page" },
        { "value": "blush", "label": "Pink" },
        { "value": "sage", "label": "Sage" },
        { "value": "sky", "label": "Sky" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Line above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the family"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "News from the studio, once a month."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
