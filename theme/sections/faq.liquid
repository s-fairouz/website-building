{%- comment -%}
  Questions and answers on one white card, as fold-outs with the same round plus as the doll
  page, then a soft link for anything not answered here.
{%- endcomment -%}

<div class="wrap doc-follow">
  {%- if section.blocks.size > 0 -%}
    <section class="doc-panel product__folds faq">
      {%- if section.settings.heading != blank -%}
        <h2 class="product__folds-title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- for block in section.blocks -%}
        <details class="detail" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </section>
  {%- endif -%}

  {%- if section.settings.link_label != blank and section.settings.link != blank -%}
    <div class="doc-onward">
      {%- if section.settings.link_text != blank -%}
        <p>{{ section.settings.link_text | escape }}</p>
      {%- endif -%}
      <a class="more" href="{{ section.settings.link }}">
        {{- section.settings.link_label | escape -}}
        {%- render 'more-arrow' -%}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Questions and answers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    { "type": "header", "content": "Link under the questions" },
    { "type": "text", "id": "link_text", "label": "Text", "default": "Can’t find your answer?" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Contact us" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Questions and answers"
    }
  ]
}
{% endschema %}
