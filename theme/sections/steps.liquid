<section class="band band--color" id="how-they-are-made">
  <div class="wrap">
    <div class="steps__head">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <ol class="steps" role="list">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title | escape }}</h3>
          <p>{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Steps",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How a doll is made"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cut"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Describe this step."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Steps",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
