{%- liquid
  assign threshold = section.settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign remaining_text = remaining | money
  assign progress = 100
  if remaining > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold | round
  endif
-%}

<dialog
  class="drawer"
  aria-labelledby="cart-drawer-title"
  data-cart-drawer
  data-cart-url="{{ routes.cart_url }}"
  data-change-url="{{ routes.cart_change_url }}"
  data-update-url="{{ routes.cart_update_url }}"
>
  <div class="drawer__body" data-cart-drawer-body data-item-count="{{ cart.item_count }}">
    <div class="drawer__head">
      <h2 id="cart-drawer-title">{{ 'cart.title' | t }}</h2>
      <button type="button" class="link" id="drawer-close" data-cart-close>{{ 'cart.close' | t }}</button>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="empty">
        <p>{{ 'cart.empty' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.shop' | t }}</a>
      </div>
    {%- else -%}
      {%- if threshold > 0 -%}
        <div class="shipping-bar">
          <p>
            {%- if remaining > 0 -%}
              {{ 'cart.free_shipping_remaining' | t: amount: remaining_text }}
            {%- else -%}
              {{ 'cart.free_shipping_reached' | t }}
            {%- endif -%}
          </p>
          <progress max="100" value="{{ progress }}" aria-label="{{ 'cart.shipping_progress' | t }}"></progress>
        </div>
      {%- endif -%}

      <ul class="cart-drawer__items" role="list">
        {%- for item in cart.items -%}
          <li class="drawer-item">
            <a class="tile drawer-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                <img
                  src="{{ item.image | image_url: width: 200 }}"
                  alt=""
                  width="{{ item.image.width }}"
                  height="{{ item.image.height }}"
                  loading="lazy"
                >
              {%- endif -%}
            </a>

            <div>
              <a class="drawer-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <p>{{ item.variant.title }}</p>
              {%- endunless -%}
              {% render 'line-properties', item: item %}

              <div class="drawer-item__row">
                <label class="visually-hidden" for="drawer-quantity-{{ forloop.index }}">
                  {{- 'cart.quantity_for' | t: title: item.product.title -}}
                </label>
                <input
                  id="drawer-quantity-{{ forloop.index }}"
                  type="number"
                  value="{{ item.quantity }}"
                  min="0"
                  inputmode="numeric"
                  data-line="{{ forloop.index }}"
                >
                <button
                  type="button"
                  class="link"
                  id="drawer-remove-{{ forloop.index }}"
                  data-remove="{{ forloop.index }}"
                  aria-label="{{ 'cart.remove_item' | t: title: item.product.title }}"
                >
                  {{- 'cart.remove' | t -}}
                </button>
              </div>
            </div>

            <p class="drawer-item__total">{{ item.final_line_price | money }}</p>
          </li>
        {%- endfor -%}
      </ul>

      <form class="drawer__foot cart-drawer__foot" action="{{ routes.cart_url }}" method="post">
        {% render 'gift-options', id_prefix: 'drawer' %}

        <p class="cart__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money }}</strong>
        </p>
        <p class="form-note">{{ 'cart.shipping_note' | t }}</p>
        <button type="submit" name="checkout" class="button" id="drawer-checkout">{{ 'cart.checkout' | t }}</button>
        <a class="link" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
      </form>
    {%- endif -%}
  </div>
</dialog>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping from",
      "info": "Order value, in your store's currency, where shipping becomes free. Set to 0 to hide the progress bar. This only shows a message; set the actual rate under Settings > Shipping and delivery.",
      "default": 150
    }
  ]
}
{% endschema %}
