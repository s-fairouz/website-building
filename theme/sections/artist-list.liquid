{%- assign artists = shop.metaobjects.artist.values -%}

{%- capture intro -%}
  {%- if section.settings.kicker != blank -%}
    <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
  {%- endif -%}
  <h2>{{ section.settings.heading | escape }}</h2>
  {%- if section.settings.text != blank -%}
    <p>{{ section.settings.text | escape }}</p>
  {%- endif -%}
{%- endcapture -%}

{%- comment -%}
  On a page of its own (no section heading) a single maker gets her profile, the same one as
  on her own page, so both read alike. On the home page she gets a wide card introduced by her
  name. With several makers, the section lists them on cards, each leading to her own page.
{%- endcomment -%}
{%- liquid
  assign own_page = false
  if artists.size == 1 and section.settings.heading == blank and template.name != 'index'
    assign own_page = true
  endif
-%}

{%- if own_page -%}
  {%- for artist in artists limit: 1 -%}
    {% render 'maker-profile', artist: artist %}
  {%- endfor -%}
{%- else -%}
<section class="band{% if section.settings.background != 'none' and section.settings.background != blank %} band--{{ section.settings.background }}{% endif %}">
  <div class="wrap">
    {%- if artists.size == 1 -%}
      {%- comment -%}
        One maker on the home page: a wide card with her portrait, her name with one quiet line
        under it (where she works and how many dolls she has made), the section's text, and the
        way to her page.
      {%- endcomment -%}
      {%- for artist in artists limit: 1 -%}
        {%- liquid
          assign portrait = artist.portrait.value
          assign works = artist.collection.value.products
        -%}
        <article class="maker-feature">
          <div class="maker-feature__portrait">
            {%- if portrait -%}
              <img
                src="{{ portrait | image_url: width: 900 }}"
                alt=""
                width="{{ portrait.width }}"
                height="{{ portrait.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          <div class="maker-feature__body">
            {%- if section.settings.heading != blank -%}
              <div class="maker-feature__intro">{{ intro }}</div>
            {%- endif -%}

            <div class="maker-feature__who">
              <h2 class="maker-feature__name">
                <a href="{{ artist.system.url }}">{{ artist.name.value | escape }}</a>
              </h2>
              {%- if artist.location.value != blank and artist.pieces_made.value -%}
                <p class="maker-feature__place">{{ 'makers.meta' | t: place: artist.location.value, count: artist.pieces_made.value }}</p>
              {%- elsif artist.location.value != blank -%}
                <p class="maker-feature__place">{{ artist.location.value | escape }}</p>
              {%- endif -%}
            </div>

            {%- comment -%} Without a section heading, the section's text follows her name. {%- endcomment -%}
            {%- if section.settings.heading == blank and section.settings.text != blank -%}
              <p class="maker-feature__text">{{ section.settings.text | escape }}</p>
            {%- endif -%}

            {%- if works.size == 0 and artist.makes.value != blank -%}
              <p class="maker-feature__makes">{{ artist.makes.value | escape }}</p>
            {%- endif -%}

            <div class="maker-feature__foot">
              {%- if section.settings.link_label != blank -%}
                <a class="button" href="{{ artist.system.url }}">{{ section.settings.link_label | escape }}</a>
              {%- endif -%}
              {%- if section.settings.story_label != blank and section.settings.story_link != blank -%}
                <a class="more" href="{{ section.settings.story_link }}">
                  {{- section.settings.story_label | escape -}}
                  {%- render 'more-arrow' -%}
                </a>
              {%- endif -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- if section.settings.heading != blank -%}
        <div class="makers__intro">
          {{ intro }}
          {%- if section.settings.link_label != blank and section.settings.link != blank -%}
            <a class="link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if artists.size > 0 -%}
        <ul class="grid" role="list">
          {%- for artist in artists -%}
            {%- assign portrait = artist.portrait.value -%}
            <li>
              <article class="maker-card">
                <a class="card__link" href="{{ artist.system.url }}">
                  <div class="tile maker-card__media">
                    {%- if portrait -%}
                      <img
                        src="{{ portrait | image_url: width: 720 }}"
                        alt=""
                        width="{{ portrait.width }}"
                        height="{{ portrait.height }}"
                        loading="lazy"
                      >
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  <h3 class="card__title">{{ artist.name.value | escape }}</h3>
                </a>
                {%- if artist.location.value != blank -%}
                  <p class="maker-card__place">{{ artist.location.value | escape }}</p>
                {%- endif -%}
                {%- if artist.pieces_made.value -%}
                  <p class="maker-card__place">{{ 'makers.pieces' | t: count: artist.pieces_made.value }}</p>
                {%- endif -%}
                {%- if artist.specialty.value != blank -%}
                  <p class="maker-card__place">{{ artist.specialty.value | escape }}</p>
                {%- endif -%}
                {%- if artist.makes.value != blank -%}
                  <p class="maker-card__makes">{{ artist.makes.value | escape }}</p>
                {%- endif -%}
                {% render 'commission-status', artist: artist %}
              </article>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="lede">{{ 'makers.empty' | t }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Makers",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "Same as the page" },
        { "value": "blush", "label": "Pink" },
        { "value": "sage", "label": "Sage" },
        { "value": "sky", "label": "Sky" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Line above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our makers"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "With a single maker this is the button to her page."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "story_label",
      "label": "Second link label",
      "info": "With a single maker, a softer link beside her button, for example to your story."
    },
    {
      "type": "url",
      "id": "story_link",
      "label": "Second link"
    }
  ],
  "presets": [
    {
      "name": "Makers"
    }
  ]
}
{% endschema %}
