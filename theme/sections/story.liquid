{%- comment -%}
  The shop's story on one white card the width of the page, like the cards around it:
  the title, a short text and a link on the left, and on the right a few figures about the
  work (the facts: a number as the title, what it counts as the text).
{%- endcomment -%}
<section class="band story">
  <div class="wrap">
    <div class="story__card">
      <div class="story__copy">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a class="more" href="{{ section.settings.link }}">
            {{- section.settings.link_label | escape -}}
            {%- render 'more-arrow' -%}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <dl class="figures">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              <dt>{{ block.settings.title | escape }}</dt>
              <dd>{{ block.settings.text | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our story"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Say why you make dolls, in a few lines.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Figure",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Number",
          "info": "Short, for example 840 or 4 h 30.",
          "default": "840"
        },
        {
          "type": "text",
          "id": "text",
          "label": "What it counts",
          "default": "stitches in every doll"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story"
    }
  ]
}
{% endschema %}
