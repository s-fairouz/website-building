<section class="band story">
  <div class="wrap story__inner">
    <div class="story__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <dl class="story__facts">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <dt>{{ block.settings.title | escape }}</dt>
            <dd>{{ block.settings.text | escape }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Line above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A doll is not just a toy."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Say why you make dolls, in two short paragraphs.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Made by hand"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "In the makers' own studios"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Story",
      "blocks": [
        { "type": "fact" },
        { "type": "fact" },
        { "type": "fact" }
      ]
    }
  ]
}
{% endschema %}
