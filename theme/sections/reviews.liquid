{%- if section.blocks.size > 0 -%}
  <section class="band reviews">
    <div class="wrap">
      <div class="reviews__head">
        {%- if section.settings.kicker != blank -%}
          <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      <ul class="reviews__list" role="list">
        {%- for block in section.blocks -%}
          <li class="review" {{ block.shopify_attributes }}>
            {%- if block.settings.stars > 0 -%}
              <p class="review__stars" role="img" aria-label="{{ 'reviews.stars' | t: count: block.settings.stars }}">
                {%- for star in (1..block.settings.stars) -%}
                  <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1l1.8 4.5h4.7L9.8 8.5l1.4 4.5L7 10.2 2.8 13l1.4-4.5L.5 5.5h4.7z"/></svg>
                {%- endfor -%}
              </p>
            {%- endif -%}
            <blockquote>
              <p>{{ block.settings.quote | escape }}</p>
            </blockquote>
            <p class="review__author">
              {{ block.settings.author | escape }}
              {%- if block.settings.relation != blank -%}
                <span>{{ block.settings.relation | escape }}</span>
              {%- endif -%}
            </p>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Line above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What families say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "What they said",
          "info": "Use a real customer's words."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "relation",
          "label": "Who they are",
          "info": "For example \"Mother of Zoé\"."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
