{%- comment -%}
  A few of the dolls, on the same cards as the catalogue. What every doll shares (made to
  order, ready in a week) is said once, under the heading, rather than on each card.
{%- endcomment -%}

<section class="band companions">
  <div class="wrap">
    <div class="band__head">
      <div>
        {%- if section.settings.kicker != blank -%}
          <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="band__sub">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <ul class="companions__list" role="list">
      {%- for block in section.blocks -%}
        {%- if block.settings.product != blank -%}
          <li {{ block.shopify_attributes }}>
            {%- render 'product-card', product: block.settings.product, badge: block.settings.badge -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- comment -%} The way on to every doll, under the ones shown here. {%- endcomment -%}
    {%- if section.settings.link_label != blank -%}
      <p class="companions__more">
        <a class="more" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{- section.settings.link_label | escape -}}
          {%- render 'more-arrow' -%}
        </a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Companions",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Line above the heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The doll workshop" },
    { "type": "text", "id": "text", "label": "Line under the heading", "info": "What every doll shares, said once here instead of on each card.", "default": "Made to order, ready in 5 to 7 days" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See all dolls" },
    { "type": "url", "id": "link", "label": "Link", "info": "Uses the catalog of every doll when empty." }
  ],
  "blocks": [
    {
      "type": "companion",
      "name": "Companion",
      "settings": [
        { "type": "product", "id": "product", "label": "Companion" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "For example \"Favorite of moms\". Leave empty for none." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Companions",
      "blocks": [
        { "type": "companion" },
        { "type": "companion" },
        { "type": "companion" },
        { "type": "companion" }
      ]
    }
  ]
}
{% endschema %}
