{%- liquid
  assign portrait = metaobject.portrait.value
  assign works = metaobject.collection.value
-%}

<div class="wrap artist stack-end">
  <div class="tile artist__portrait">
    {%- if portrait -%}
      <img
        src="{{ portrait | image_url: width: 900 }}"
        alt="{{ portrait.alt | default: metaobject.name.value | escape }}"
        width="{{ portrait.width }}"
        height="{{ portrait.height }}"
      >
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="artist__info">
    <h1>{{ metaobject.name.value | escape }}</h1>
    {%- if metaobject.location.value != blank -%}
      <p class="artist__place">{{ metaobject.location.value | escape }}</p>
    {%- endif -%}
    {% render 'commission-status', artist: metaobject %}

    {%- if metaobject.bio.value != blank -%}
      <div class="rte"><p>{{ metaobject.bio.value | escape | newline_to_br }}</p></div>
    {%- endif -%}

    {%- if metaobject.philosophy.value != blank -%}
      <h2>{{ 'makers.materials' | t }}</h2>
      <div class="rte"><p>{{ metaobject.philosophy.value | escape | newline_to_br }}</p></div>
    {%- endif -%}

    {%- if metaobject.instagram.value != blank -%}
      <a class="link" href="{{ metaobject.instagram.value }}" rel="noopener">
        {{- 'makers.instagram' | t: name: metaobject.name.value -}}
      </a>
    {%- endif -%}
  </div>
</div>

{%- if works.products.size > 0 -%}
  <section class="band band--color">
    <div class="wrap">
      <div class="band__head">
        <h2>{{ 'makers.pieces_by' | t: name: metaobject.name.value }}</h2>
      </div>
      <ul class="grid" role="list">
        {%- for product in works.products limit: 8 -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Maker profile"
}
{% endschema %}
