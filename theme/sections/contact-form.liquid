{%- comment -%}
  The contact form on a white card, with soft filled fields like the rest of the site, and
  beside it a second card that points to the answers people most often write in for.
{%- endcomment -%}

<div class="wrap doc-follow" id="contact-form">
  <div class="doc-split doc-split--wide">
    <section class="doc-panel">
      {% form 'contact', class: 'contact-form' %}
        {%- if form.posted_successfully? -%}
          <p class="notice" role="status">{{ section.settings.success | escape }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}

        <div class="contact-form__row">
          <div class="field field--soft">
            <label for="contact-name">{{ 'contact.name' | t }}</label>
            <input id="contact-name" type="text" name="contact[name]" autocomplete="name">
          </div>
          <div class="field field--soft">
            <label for="contact-email">{{ 'contact.email' | t }}</label>
            <input id="contact-email" type="email" name="contact[email]" autocomplete="email" required>
          </div>
        </div>
        <div class="field field--soft">
          <label for="contact-message">{{ 'contact.message' | t }}</label>
          <textarea id="contact-message" name="contact[body]" rows="6" required></textarea>
        </div>
        <button type="submit" class="button">{{ 'contact.send' | t }}</button>
      {% endform %}
    </section>

    {%- if section.settings.aside_title != blank -%}
      <section class="doc-panel doc-aside">
        <h2 class="doc-panel__title">{{ section.settings.aside_title | escape }}</h2>
        {%- if section.settings.aside_text != blank -%}
          <p class="doc-aside__text">{{ section.settings.aside_text | escape }}</p>
        {%- endif -%}
        <div class="doc-aside__links">
          {%- if section.settings.link_1_label != blank and section.settings.link_1 != blank -%}
            <a class="more" href="{{ section.settings.link_1 }}">
              {{- section.settings.link_1_label | escape -}}
              {%- render 'more-arrow' -%}
            </a>
          {%- endif -%}
          {%- if section.settings.link_2_label != blank and section.settings.link_2 != blank -%}
            <a class="more" href="{{ section.settings.link_2 }}">
              {{- section.settings.link_2_label | escape -}}
              {%- render 'more-arrow' -%}
            </a>
          {%- endif -%}
        </div>
      </section>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "success",
      "label": "Message shown after sending",
      "default": "Message sent. We reply within two business days."
    },
    { "type": "header", "content": "Card beside the form" },
    { "type": "text", "id": "aside_title", "label": "Title", "default": "Before you write" },
    { "type": "textarea", "id": "aside_text", "label": "Text", "default": "Your answer may already be here." },
    { "type": "text", "id": "link_1_label", "label": "First link label", "default": "Questions and answers" },
    { "type": "url", "id": "link_1", "label": "First link" },
    { "type": "text", "id": "link_2_label", "label": "Second link label", "default": "Shipping and returns" },
    { "type": "url", "id": "link_2", "label": "Second link" }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
