<div class="wrap page-head">
  <h1>
    {%- if search.performed -%}
      {{ 'search.results_for' | t: terms: search.terms }}
    {%- else -%}
      {{ 'search.title' | t }}
    {%- endif -%}
  </h1>

  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="search-terms">{{ 'general.search_label' | t }}</label>
    <input id="search-terms" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button type="submit" class="button">{{ 'search.submit' | t }}</button>
  </form>
</div>

{%- if search.performed -%}
  {% paginate search.results by 12 %}
    {%- capture clear_url -%}{{ routes.search_url }}?q={{ search.terms | url_encode }}&type=product{%- endcapture -%}

    <div class="wrap stack-end">
      {%- capture count_label -%}{%- if search.results_count > 0 -%}{{ 'search.results_count' | t: count: search.results_count }}{%- endif -%}{%- endcapture -%}
      {% render 'facets', results: search, clear_url: clear_url, terms: search.terms, count_label: count_label %}

        {%- if search.results_count == 0 -%}
          <div class="empty">
            <p>{{ 'search.no_results' | t: terms: search.terms }}</p>
            <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'search.browse_all' | t }}</a>
          </div>
        {%- else -%}
          <ul class="grid" role="list" data-load-more-grid>
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <a class="link" href="{{ item.url }}">{{ item.title }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {%- assign shown = paginate.current_offset | plus: search.results.size -%}
          {% render 'load-more', paginate: paginate, shown: shown %}
        {%- endif -%}
    </div>
  {% endpaginate %}
{%- else -%}
  <div class="stack-end"></div>
{%- endif -%}

{% schema %}
{
  "name": "Search results"
}
{% endschema %}
