{%- comment -%}
  The adoption certificate page, in the site's own cards:
  - a title and one line saying what the page is: the certificate every doll comes with, shown
    here with one example;
  - the certificate: the doll's photo, its number, the child and the doll, the adoption date,
    the gift message, and what the doll is made of;
  - how the doll was made, step by step, and who made it, with her message to the child;
  - a way to share a photo.
  The doll's facts come from its product metafields and its maker; the names, number, dates
  and messages are typed in here. This shows one certificate. A different one per order needs
  an app, not a theme.
{%- endcomment -%}

{%- liquid
  assign doll = section.settings.product
  assign artist = doll.metafields.custom.artist.value
  assign portrait = artist.portrait.value
  assign materials = doll.metafields.custom.materials.value
  assign making_time = doll.metafields.custom.making_time.value
  assign stitches = doll.metafields.custom.stitches.value
-%}

<section class="band record">
  <div class="wrap doc-page">
    <header class="doc-intro">
      <h1>{{ 'record.intro_title' | t }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="band__sub">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>

    <article class="doc-card">
      {%- if doll.featured_image -%}
        <div class="doc-card__photo">
          <img
            src="{{ doll.featured_image | image_url: width: 900 }}"
            alt="{{ doll.title | escape }}"
            width="{{ doll.featured_image.width }}"
            height="{{ doll.featured_image.height }}"
          >
        </div>
      {%- endif -%}

      <div class="doc-card__body">
        {%- if section.settings.number != blank -%}
          <p class="doc-card__number">{{ 'record.number' | t: number: section.settings.number }}</p>
        {%- endif -%}
        <h2 class="doc-card__title">
          {{ section.settings.child | escape }}
          {%- if doll %} &amp; {{ doll.title }}{% endif -%}
        </h2>
        {%- if section.settings.date != blank -%}
          <p class="doc-card__date">{{ 'record.adopted_on' | t: date: section.settings.date }}</p>
        {%- endif -%}

        {%- if section.settings.message != blank -%}
          <blockquote class="doc-card__message">
            <p>{{ 'record.quote' | t: text: section.settings.message }}</p>
            {%- if section.settings.message_from != blank -%}
              <footer>{{ section.settings.message_from | escape }}</footer>
            {%- endif -%}
          </blockquote>
        {%- endif -%}

        <dl class="ticket__lines doc-card__facts">
          {%- if doll -%}
            <div>
              <dt>{{ 'journey.doll' | t }}</dt>
              <dd>{{ doll.title }}, {{ doll.type | downcase }}</dd>
            </div>
          {%- endif -%}
          {%- if materials != blank -%}
            <div>
              <dt>{{ 'products.materials' | t }}</dt>
              <dd>
                {{- materials | escape -}}
                {%- if section.settings.colour != blank %}, {{ section.settings.colour | escape }}{% endif -%}
              </dd>
            </div>
          {%- endif -%}
          {%- if making_time != blank -%}
            <div>
              <dt>{{ 'products.making_time' | t }}</dt>
              <dd>{{ making_time | escape }}</dd>
            </div>
          {%- endif -%}
          {%- if stitches != blank -%}
            <div>
              <dt>{{ 'products.stitches' | t }}</dt>
              <dd>{{ stitches | escape }}</dd>
            </div>
          {%- endif -%}
        </dl>
      </div>
    </article>

    <div class="doc-split">
      {%- if section.blocks.size > 0 -%}
        <section class="doc-panel">
          <h2 class="doc-panel__title">{{ 'record.how_made' | t: doll: doll.title }}</h2>
          <ol class="making-steps step-list" role="list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="making-steps__number" aria-hidden="true">{{ forloop.index }}</span>
                <span>
                  <span class="step-list__title">{{ block.settings.title | escape }}</span>
                  {%- if block.settings.text != blank -%}
                    <span class="step-list__when">{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ol>
        </section>
      {%- endif -%}

      {%- if artist -%}
        <section class="doc-panel maker-mini">
          <h2 class="doc-panel__title">{{ 'record.the_maker' | t }}</h2>
          <div class="maker-mini__who">
            {%- if portrait -%}
              <img class="maker-mini__portrait" src="{{ portrait | image_url: width: 240 }}" alt="" width="64" height="64" loading="lazy">
            {%- endif -%}
            <div>
              <p class="maker-mini__name">{{ artist.name.value | escape }}</p>
              {%- if artist.location.value != blank -%}
                <p class="maker-mini__place">{{ 'makers.place' | t: place: artist.location.value }}</p>
              {%- endif -%}
            </div>
          </div>
          {%- if section.settings.maker_message != blank -%}
            <blockquote class="maker-mini__message">
              <p>{{ 'record.quote' | t: text: section.settings.maker_message }}</p>
              <footer>{{ artist.name.value | escape }}</footer>
            </blockquote>
          {%- endif -%}
          <a class="more" href="{{ artist.system.url }}">
            {{- 'record.meet' | t: name: artist.name.value -}}
            {%- render 'more-arrow' -%}
          </a>
        </section>
      {%- endif -%}
    </div>

    {%- if section.settings.share_text != blank -%}
      <div class="doc-onward">
        <p>{{ section.settings.share_text | escape }}</p>
        {%- if section.settings.share_label != blank and section.settings.share_link != blank -%}
          <a class="more" href="{{ section.settings.share_link }}">
            {{- section.settings.share_label | escape -}}
            {%- render 'more-arrow' -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Adoption certificate",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows one certificate as an example, with the doll's details filled in from the product. A different certificate for each order needs an app."
    },
    { "type": "textarea", "id": "intro", "label": "Line under the title", "info": "Say what the page shows.", "default": "Every doll comes with its certificate, signed by the maker. Here is an example." },
    { "type": "product", "id": "product", "label": "Doll" },
    { "type": "text", "id": "child", "label": "Child's name", "default": "Léa" },
    { "type": "text", "id": "number", "label": "Certificate number", "default": "HW-2025-00142" },
    { "type": "text", "id": "date", "label": "Adoption date", "default": "May 14, 2025" },
    { "type": "textarea", "id": "message", "label": "Gift message", "default": "With all my love, so that you are never alone." },
    { "type": "text", "id": "message_from", "label": "Message signed by", "default": "Granny Suzanne" },
    { "type": "text", "id": "colour", "label": "Color", "default": "pastel mauve" },
    { "type": "header", "content": "The maker" },
    { "type": "textarea", "id": "maker_message", "label": "Maker's message to the child" },
    { "type": "header", "content": "Under the certificate" },
    { "type": "textarea", "id": "share_text", "label": "Text" },
    { "type": "text", "id": "share_label", "label": "Link label" },
    { "type": "url", "id": "share_link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Making step",
      "settings": [
        { "type": "text", "id": "title", "label": "Step", "default": "Body crocheted" },
        { "type": "text", "id": "text", "label": "Date and detail", "default": "May 7, 2025, 2 hours of work" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Adoption certificate",
      "blocks": [
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
