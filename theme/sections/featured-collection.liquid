{%- liquid
  assign collection = section.settings.collection | default: collections.all
  assign limit = section.settings.products_to_show
-%}

<section class="band">
  <div class="wrap">
    <div class="band__head">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a class="link" href="{{ collection.url | default: routes.all_products_collection_url }}">
          {{- section.settings.link_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <ul class="grid" role="list">
      {%- for product in collection.products limit: limit -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>
            <div class="card">
              <div class="tile card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
              <h3 class="card__title">{{ 'general.placeholder_title' | t }}</h3>
              <p class="price">{{ 'general.placeholder_text' | t }}</p>
            </div>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Looking for a home"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Shows all products when no collection is chosen."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "See all dolls"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
