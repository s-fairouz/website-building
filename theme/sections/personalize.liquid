{%- liquid
  assign addon = section.settings.embroidery_product
  assign addon_variant = addon.selected_or_first_available_variant
-%}

<section class="band{% if section.settings.background != 'none' and section.settings.background != blank %} band--{{ section.settings.background }}{% endif %} personalize">
  <div class="wrap personalize__inner">
    {%- comment -%} A sample of the embroidery: the name as it would be stitched. {%- endcomment -%}
    <figure class="personalize__card">
      <div class="personalize__sample" aria-hidden="true">
        <p>{{ section.settings.sample_name | escape }}</p>
      </div>
      {%- if section.settings.caption != blank -%}
        <figcaption>{{ section.settings.caption | escape }}</figcaption>
      {%- endif -%}
    </figure>

    <div class="personalize__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="lede">{{ section.settings.text | escape }}</p>
      {%- endif -%}

      {%- if addon_variant -%}
        {%- assign addon_text = addon_variant.price | money -%}
        <p class="personalize__price">
          <strong>+ {{ addon_text }}</strong>
          {{ 'products.name_days' | t: days: section.settings.embroidery_days }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Personalization",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "Same as the page" },
        { "value": "blush", "label": "Pink" },
        { "value": "sage", "label": "Sage" },
        { "value": "sky", "label": "Sky" }
      ],
      "default": "none"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Line above the heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Give it a name."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Have a child's name embroidered on their doll, by hand."
    },
    {
      "type": "text",
      "id": "sample_name",
      "label": "Name shown as the sample",
      "default": "Léa"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption under the sample"
    },
    {
      "type": "product",
      "id": "embroidery_product",
      "label": "Embroidery charge",
      "info": "The same product chosen on the product page. Its price is shown here."
    },
    {
      "type": "range",
      "id": "embroidery_days",
      "label": "Extra working days for a name",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Personalize a doll"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Personalization"
    }
  ]
}
{% endschema %}
