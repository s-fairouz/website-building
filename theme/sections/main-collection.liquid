<div class="wrap page-head">
  {%- if section.settings.eyebrow != blank -%}
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
  {%- endif -%}
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <div class="rte lede">{{ collection.description }}</div>
  {%- endif -%}
</div>

{% paginate collection.products by section.settings.per_page %}
  <div class="wrap stack-end">
    {%- capture count_label -%}{{ 'collections.count' | t: count: collection.products_count }}{%- endcapture -%}
    {% render 'facets', results: collection, clear_url: collection.url, count_label: count_label %}

    {%- if collection.products.size == 0 -%}
      <div class="empty">
        <p>{{ 'collections.empty' | t }}</p>
        <a class="button" href="{{ collection.url }}">{{ 'collections.clear' | t }}</a>
      </div>
    {%- else -%}
      <ul class="grid" role="list">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pages' | t }}">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endif -%}
  </div>
{% endpaginate %}

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Line above the title",
      "info": "A short line about how the collection is made. Only claim certifications you hold.",
      "default": "Handcrafted in small batches"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}
