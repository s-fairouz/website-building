{%- comment -%}
  Name field for products whose "personalizable" metafield is on.
  The name is sent as a line item property, so it shows on the order.
  Accepts:
  - product: {Object} the product
  - charge: {String} optional, what a name costs, already formatted as money
  - days: {Number} optional, how many working days a name adds
{%- endcomment -%}

{%- if product.metafields.custom.personalizable.value -%}
  <div class="field field--name">
    <div class="field__head">
      <label for="engraving">{{ 'products.engraving_label' | t }}</label>
      {%- if charge != blank -%}
        <span class="field__extra">+ {{ charge }}</span>
      {%- endif -%}
    </div>
    <input
      id="engraving"
      type="text"
      name="properties[{{ 'products.engraving' | t }}]"
      maxlength="12"
      autocomplete="off"
      placeholder="{{ 'products.name_placeholder' | t }}"
      aria-describedby="engraving-hint"
      data-name
    >
    {%- comment -%}
      The price is beside the label, so the hint only says what to expect. The script shows
      how many letters are left once something is typed.
    {%- endcomment -%}
    <div class="field__foot">
      <p class="form-note" id="engraving-hint">
        {%- if days != blank -%}
          {{ 'products.name_hint_days' | t: days: days }}
        {%- else -%}
          {{ 'products.engraving_hint' | t }}
        {%- endif -%}
      </p>
      <p class="form-note field__count" aria-hidden="true" data-name-count data-text-left="{{ 'products.letters_left' | t }}" hidden></p>
    </div>
  </div>
{%- endif -%}
