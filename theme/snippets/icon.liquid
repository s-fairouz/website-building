{%- comment -%}
  A small line icon, drawn in the text colour. Shared by the promise strip and the story facts.
  Usage: {% render 'icon', name: 'hand' %}
  Names: hand, soft, name, certificate, france, leaf, time, heart.
{%- endcomment -%}
<svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
    {%- case name -%}
      {%- when 'soft' -%}
        <path d="M7 18.5h10a4 4 0 0 0 .6-7.95A5.5 5.5 0 0 0 7.1 9.05 4.75 4.75 0 0 0 7 18.5Z"/>
      {%- when 'name' -%}
        <path d="M4.5 19.5 16 8"/>
        <ellipse cx="17.6" cy="6.4" rx="1.3" ry="2.4" transform="rotate(45 17.6 6.4)"/>
        <path d="M18.8 7.6c2 2.8.5 6-2.8 6.6-2.6.5-4.2 2-3.6 4.6"/>
      {%- when 'certificate' -%}
        <circle cx="12" cy="9" r="5.5"/>
        <path d="M9 13.8 7.8 21 12 18.6l4.2 2.4-1.2-7.2"/>
      {%- when 'france' -%}
        <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/>
        <circle cx="12" cy="10" r="2.3"/>
      {%- when 'leaf' -%}
        <path d="M5 19c0-8 5-13.5 14-14 .5 9-5 14-12 14H5Z"/>
        <path d="M5 19 13 11"/>
      {%- when 'time' -%}
        <circle cx="12" cy="12" r="8.5"/>
        <path d="M12 7.5V12l3 2"/>
      {%- when 'heart' -%}
        <path d="M12 19.5s-7.5-4.4-7.5-10A4.2 4.2 0 0 1 12 7a4.2 4.2 0 0 1 7.5 2.5c0 5.6-7.5 10-7.5 10Z"/>
      {%- else -%}
        <circle cx="11" cy="11" r="7.5"/>
        <path d="M4.2 8.6c4.2-.6 9 1.4 11.6 6.8"/>
        <path d="M3.8 12.6c3.6-.4 7.2 1.2 9 5.6"/>
        <path d="M8.6 3.9c3 2.2 5.4 5.8 6 10.8"/>
        <path d="M16.3 16.3c1.4 1.6 2.9 2.6 4.7 2.2"/>
    {%- endcase -%}
  </g>
</svg>
