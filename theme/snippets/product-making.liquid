{%- comment -%}
  What the doll is made of and how it was made, from the product's metafields.
  The facts sit in the doll's story; the steps sit in their own fold-out.
  Accepts:
  - product: {Object} the product
  - show: {String} 'facts' or 'steps'
{%- endcomment -%}

{%- liquid
  assign materials = product.metafields.custom.materials.value
  assign technique = product.metafields.custom.technique.value
  assign making_time = product.metafields.custom.making_time.value
  assign stitches = product.metafields.custom.stitches.value
  assign steps = product.metafields.custom.making_steps.value
-%}

{%- if show == 'facts' -%}
  {%- if materials != blank or technique != blank or making_time != blank or stitches != blank -%}
    <dl class="facts">
      {%- if materials != blank -%}
        <div>
          <dt>{{ 'products.materials' | t }}</dt>
          <dd>{{ materials | escape }}</dd>
        </div>
      {%- endif -%}
      {%- if technique != blank -%}
        <div>
          <dt>{{ 'products.technique' | t }}</dt>
          <dd>{{ technique | escape }}</dd>
        </div>
      {%- endif -%}
      {%- if making_time != blank -%}
        <div>
          <dt>{{ 'products.making_time' | t }}</dt>
          <dd>{{ making_time | escape }}</dd>
        </div>
      {%- endif -%}
      {%- if stitches != blank -%}
        <div>
          <dt>{{ 'products.stitches' | t }}</dt>
          <dd>{{ stitches | escape }}</dd>
        </div>
      {%- endif -%}
    </dl>
  {%- endif -%}
{%- elsif show == 'steps' and steps.size > 0 -%}
  <ol class="making-steps" role="list">
    {%- for step in steps -%}
      <li><span class="making-steps__number" aria-hidden="true">{{ forloop.index }}</span>{{ step | escape }}</li>
    {%- endfor -%}
  </ol>
{%- endif -%}
