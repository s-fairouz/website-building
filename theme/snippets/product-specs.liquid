{%- comment -%}
  Height, size and available colours, from the product's metafields.
  Accepts:
  - product: {Object} the product
  - compact: {Boolean} one short line for product cards (optional)
  - hide_colors: {Boolean} leave the colours out, when the variant picker already shows them (optional)
{%- endcomment -%}

{%- liquid
  assign height = product.metafields.custom.height_cm.value
  assign size = product.metafields.custom.size.value
  assign colors = product.metafields.custom.colors.value
  assign inches = height | times: 0.3937 | round
  if hide_colors
    assign colors = nil
  endif
-%}

{%- if compact -%}
  {%- if height or colors.size > 0 -%}
    <p class="card__specs">
      {%- if height -%}
        <span>{{ 'products.height_short' | t: cm: height }}</span>
      {%- endif -%}
      {%- if colors.size > 0 -%}
        <span class="swatches">
          {%- for color in colors -%}
            <span class="swatch" style="--swatch: {{ color.swatch.value }}"></span>
          {%- endfor -%}
          <span class="visually-hidden">
            {{- 'products.colors' | t }}: {{ colors | map: 'name' | map: 'value' | join: ', ' | escape -}}
          </span>
        </span>
      {%- endif -%}
    </p>
  {%- endif -%}
{%- elsif height or size != blank or colors.size > 0 -%}
  <div class="specs">
    {%- if height -%}
      {%- comment -%}
        The doll against a tailor's tape. The tape is always 45 cm long (5 units to the
        centimetre, zero at y = 240), so dolls of different heights can be compared.
      {%- endcomment -%}
      {%- liquid
        assign doll_height = height | at_most: 45 | times: 5
        assign doll_width = doll_height | times: 0.44
        assign doll_top = 240 | minus: doll_height
        assign doll_left = doll_width | divided_by: 2.0
        assign doll_left = 108 | minus: doll_left
        assign label_y = doll_top | minus: 6
      -%}
      <svg class="specs__figure" viewBox="0 0 160 250" aria-hidden="true">
        <defs>
          <pattern id="tape-cm" width="26" height="5" patternUnits="userSpaceOnUse">
            <path d="M0 0h5"/>
          </pattern>
          <pattern id="tape-5cm" y="15" width="26" height="25" patternUnits="userSpaceOnUse">
            <path d="M0 0h9"/>
          </pattern>
        </defs>
        <rect class="specs__tape" x="0" y="15" width="26" height="225" rx="2"/>
        <rect x="0" y="15" width="26" height="225" fill="url(#tape-cm)"/>
        <rect x="0" y="15" width="26" height="225" fill="url(#tape-5cm)"/>
        {%- for ten in (1..4) -%}
          {%- liquid
            assign mark = ten | times: 10
            assign mark_y = ten | times: 50
            assign mark_y = 244 | minus: mark_y
          -%}
          <text class="specs__mark" x="23" y="{{ mark_y }}" text-anchor="end">{{ mark }}</text>
        {%- endfor -%}
        <path class="specs__ground" d="M0 240h160"/>
        <svg x="{{ doll_left }}" y="{{ doll_top }}" width="{{ doll_width }}" height="{{ doll_height }}" viewBox="0 0 44 100" overflow="visible">
          <g class="specs__doll">
            <rect x="14.5" y="64" width="6" height="35" rx="3"/>
            <rect x="23.5" y="64" width="6" height="35" rx="3"/>
            <path d="M15 33 L4 56"/>
            <path d="M29 33 L40 56"/>
            <path d="M14 30 Q22 27 30 30 L37 68 Q22 73 7 68 Z"/>
            <circle cx="22" cy="16" r="15"/>
          </g>
        </svg>
        <path class="specs__reach" d="M26 {{ doll_top }}H108"/>
        <text class="specs__height" x="34" y="{{ label_y }}">{{ height }} cm</text>
      </svg>
    {%- endif -%}

    <dl class="specs__facts">
      {%- if height -%}
        <div>
          <dt>{{ 'products.height' | t }}</dt>
          <dd>{{ 'products.height_value' | t: cm: height, inches: inches }}</dd>
        </div>
      {%- endif -%}
      {%- if size != blank -%}
        <div>
          <dt>{{ 'products.size' | t }}</dt>
          <dd>{{ size | escape }}</dd>
        </div>
      {%- endif -%}
      {%- if colors.size > 0 -%}
        <div>
          <dt>{{ 'products.colors' | t }}</dt>
          <dd>
            <ul class="swatches swatches--named" role="list">
              {%- for color in colors -%}
                <li>
                  <span class="swatch" style="--swatch: {{ color.swatch.value }}"></span>
                  {{ color.name.value | escape }}
                </li>
              {%- endfor -%}
            </ul>
          </dd>
        </div>
      {%- endif -%}
    </dl>
  </div>
{%- endif -%}
