{%- comment -%}
  Catalog controls for a collection or a search: quick filter pills, a filter drawer and a sort menu.
  Filters come from Shopify (Search & Discovery app), so whatever the shop turns on appears here.
  Accepts:
  - results: {Object} the collection or search object
  - clear_url: {String} where "All dolls" and "Clear filters" go
  - terms: {String} optional, the search terms to keep when filtering a search
  - count_label: {String} optional, how many results there are, shown beside the tools
{%- endcomment -%}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by | default: 'relevance'
  assign sort_name = ''
  for option in results.sort_options
    if option.value == sort_by
      assign sort_name = option.name
    endif
  endfor

  assign active_count = 0
  for filter in results.filters
    assign active_count = active_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value or filter.max_value.value
        assign active_count = active_count | plus: 1
      endif
    endif
  endfor
-%}

{%- comment -%}
  Photos for the bubbles come from the whole catalogue, not from the filtered results,
  so every animal keeps its picture while another one is chosen.
{%- endcomment -%}
{%- assign pool = collections.all.products | default: results.products -%}

<div class="catalog-bar">
  <ul class="bubbles" role="list">
    <li>
      <a class="bubble" href="{{ clear_url }}"{% if active_count == 0 %} aria-current="true"{% endif %}>
        <span class="bubble__photo bubble__photo--all">
          {%- for product in pool limit: 4 -%}
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="60" height="60" loading="lazy">
            {%- endif -%}
          {%- endfor -%}
        </span>
        <span class="bubble__name">{{ 'collections.all' | t }}</span>
      </a>
    </li>
    {%- for filter in results.filters -%}
      {%- unless filter.type == 'list' and filter.param_name contains 'product_type' -%}
        {%- continue -%}
      {%- endunless -%}
      {%- for value in filter.values -%}
        {%- unless value.active or value.count > 0 -%}
          {%- continue -%}
        {%- endunless -%}
        {%- liquid
          assign photo = nil
          for product in pool
            if product.type == value.value or product.type == value.label
              assign photo = product.featured_image
              break
            endif
          endfor
        -%}
        <li>
          <a
            class="bubble"
            href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}"
            {% if value.active %}aria-current="true"{% endif %}
          >
            <span class="bubble__photo">
              {%- if photo -%}
                <img src="{{ photo | image_url: width: 200 }}" alt="" width="100" height="100" loading="lazy">
              {%- else -%}
                {{ value.label | slice: 0 | upcase }}
              {%- endif -%}
            </span>
            <span class="bubble__name">{{ value.label | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    {%- endfor -%}
  </ul>

  <div class="catalog-bar__status">
    {%- if count_label != blank -%}
      <p class="listing__count">{{ count_label }}</p>
    {%- endif -%}

    {%- comment -%} Conditions, as opposed to animals: small switches beside the count. {%- endcomment -%}
    <ul class="catalog-bar__switches" role="list">
      {%- for filter in results.filters -%}
        {%- case filter.type -%}
          {%- when 'list' -%}
            {%- if filter.param_name contains 'product_type' -%}
              {%- continue -%}
            {%- endif -%}
            {%- for value in filter.values -%}
              {%- comment -%} "Sold out" is not something to browse by, and empty choices lead nowhere. {%- endcomment -%}
              {%- if filter.param_name contains 'availability' and value.value == '0' -%}
                {%- continue -%}
              {%- endif -%}
              {%- if value.active -%}
                <li><a class="pill pill--switch" href="{{ value.url_to_remove }}" aria-current="true">{{ value.label | escape }}</a></li>
              {%- elsif value.count > 0 -%}
                <li><a class="pill pill--switch" href="{{ value.url_to_add }}">{{ value.label | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          {%- when 'boolean' -%}
            {%- if filter.true_value.active -%}
              <li><a class="pill pill--switch" href="{{ filter.true_value.url_to_remove }}" aria-current="true">{{ filter.label | escape }}</a></li>
            {%- elsif filter.true_value.count > 0 -%}
              <li><a class="pill pill--switch" href="{{ filter.true_value.url_to_add }}">{{ filter.label | escape }}</a></li>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </ul>
  </div>

  <div class="catalog-bar__tools">
    {%- if results.filters.size > 0 -%}
      <button
        type="button"
        class="pill pill--tool"
        commandfor="filter-drawer"
        command="show-modal"
        data-open-filters
      >
        <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
          <path d="M3 6h14M6 10h8M8.5 14h3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        {{ 'collections.filters' | t }}
        {%- if active_count > 0 %} <span class="pill__count">{{ active_count }}</span>{% endif -%}
      </button>
    {%- endif -%}

    <form class="sort" method="get" data-auto-submit>
      {%- comment -%} Changing the order must not drop the filters already chosen. {%- endcomment -%}
      {%- if terms -%}
        <input type="hidden" name="q" value="{{ terms | escape }}">
        <input type="hidden" name="type" value="product">
      {%- endif -%}
      {%- for filter in results.filters -%}
        {%- for value in filter.active_values -%}
          <input type="hidden" name="{{ value.param_name }}" value="{{ value.value | escape }}">
        {%- endfor -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value -%}
            <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}">
          {%- endif -%}
          {%- if filter.max_value.value -%}
            <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      <details class="dropdown" data-dropdown>
        <summary class="pill pill--tool"><span class="pill__label">{{ 'collections.sort_by' | t }}</span> {{ sort_name | escape }}</summary>
        <div class="dropdown__panel">
          {%- for option in results.sort_options -%}
            <label class="dropdown__option">
              <input type="radio" name="sort_by" value="{{ option.value | escape }}"{% if option.value == sort_by %} checked{% endif %}>
              <span>{{ option.name | escape }}</span>
            </label>
          {%- endfor -%}
          <button type="submit" class="button facets__apply">{{ 'collections.apply' | t }}</button>
        </div>
      </details>
    </form>
  </div>
</div>

{%- if results.filters.size > 0 -%}
  <dialog class="drawer" id="filter-drawer" aria-labelledby="filter-drawer-title" data-filter-drawer>
    <form class="drawer__body facets" method="get">
      <div class="drawer__head">
        <h2 id="filter-drawer-title">{{ 'collections.filters' | t }}</h2>
        <button type="button" class="drawer__close" aria-label="{{ 'general.close' | t }}" data-close-dialog>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
      </div>

      {%- if terms -%}
        <input type="hidden" name="q" value="{{ terms | escape }}">
        <input type="hidden" name="type" value="product">
      {%- endif -%}
      {%- if results.sort_by -%}
        <input type="hidden" name="sort_by" value="{{ results.sort_by | escape }}">
      {%- endif -%}

      <div class="facets__groups">
        {%- for filter in results.filters -%}
          <fieldset class="facet">
            <legend>{{ filter.label | escape }}</legend>

            {%- case filter.type -%}
              {%- when 'list' -%}
                <div class="chips">
                  {%- for value in filter.values -%}
                    <label class="chip">
                      <input
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value | escape }}"
                        {% if value.active %}checked{% endif %}
                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                      >
                      <span>{{ value.label | escape }} ({{ value.count }})</span>
                    </label>
                  {%- endfor -%}
                </div>

              {%- when 'boolean' -%}
                <div class="chips">
                  <label class="chip">
                    <input
                      type="checkbox"
                      name="{{ filter.true_value.param_name }}"
                      value="{{ filter.true_value.value | escape }}"
                      {% if filter.true_value.active %}checked{% endif %}
                    >
                    <span>{{ filter.label | escape }} ({{ filter.true_value.count }})</span>
                  </label>
                </div>

              {%- when 'price_range' -%}
                <div class="facet__range">
                  <label>
                    {{ 'collections.price_from' | t }}
                    <input
                      type="number"
                      name="{{ filter.min_value.param_name }}"
                      {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                      min="0"
                      step="any"
                      placeholder="0"
                    >
                  </label>
                  <label>
                    {{ 'collections.price_to' | t }}
                    <input
                      type="number"
                      name="{{ filter.max_value.param_name }}"
                      {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                      min="0"
                      step="any"
                      placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                    >
                  </label>
                </div>
            {%- endcase -%}
          </fieldset>
        {%- endfor -%}
      </div>

      <div class="drawer__foot">
        <button type="submit" class="button">{{ 'collections.show_results' | t }}</button>
        {%- if active_count > 0 -%}
          <a class="link" href="{{ clear_url }}">{{ 'collections.clear' | t }}</a>
        {%- endif -%}
      </div>
    </form>
  </dialog>
{%- endif -%}
