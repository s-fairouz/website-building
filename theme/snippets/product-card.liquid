{%- comment -%}
  Renders one product in a grid: the photo, then its name, what it is and its price.
  The whole card is one link to the product; the round arrow is part of that link.
  Accepts:
  - product: {Object} the product to show
{%- endcomment -%}

{%- liquid
  assign image = product.featured_image
  assign hover_image = product.images[1]
  assign variant = product.selected_or_first_available_variant
-%}

<article class="card{% unless product.available %} card--sold-out{% endunless %}">
  <a class="card__open" href="{{ product.url }}">
    <div class="tile card__media">
      {%- if image -%}
        <img
          src="{{ image | image_url: width: 720 }}"
          alt=""
          width="{{ image.width }}"
          height="{{ image.height }}"
          loading="lazy"
        >
        {%- if hover_image -%}
          <img
            class="card__hover-image"
            src="{{ hover_image | image_url: width: 720 }}"
            alt=""
            width="{{ hover_image.width }}"
            height="{{ hover_image.height }}"
            loading="lazy"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      {%- comment -%} One tag at most, on the photo. {%- endcomment -%}
      {%- if product.available == false -%}
        <span class="flag flag--plain">{{ 'products.sold_out' | t }}</span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="flag">{{ 'products.sale' | t }}</span>
      {%- elsif variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 5 -%}
        <span class="flag flag--ready">{{ 'products.in_stock' | t: count: variant.inventory_quantity }}</span>
      {%- elsif product.metafields.custom.lead_time_min_days.value -%}
        <span class="flag flag--ready">{{ 'products.made_to_order' | t }}</span>
      {%- endif -%}
    </div>

    <div class="card__body">
      <h3 class="card__title">{{ product.title }}</h3>
      {%- if product.type != blank -%}
        <p class="card__kind">{{ 'companions.kind' | t: kind: product.type | downcase }}</p>
      {%- endif -%}

      <div class="card__foot">
        {% render 'price', product: product %}
        {%- if product.available -%}
          <span class="card__go" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14">
              <path d="M4.5 11.5 11.5 4.500M5.5 4.500h6v6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        {%- endif -%}
      </div>
    </div>
  </a>
</article>
